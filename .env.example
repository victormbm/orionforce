# ===== Orion Force — variáveis de ambiente =====
# Copie este arquivo para ".env.local" e preencha quando for conectar o banco.

# Backend de dados usado pela aplicação:
#   local -> salva no navegador (localStorage)  [padrão atual]
#   api   -> usa as rotas /api/members + banco do Vercel
NEXT_PUBLIC_DATA_BACKEND=local

# ===== Banco do Vercel (Postgres) — preencher na migração =====
# Essas variáveis são criadas automaticamente pelo Vercel ao adicionar
# um banco "Postgres" no projeto (Storage > Create Database). Depois é só
# rodar `vercel env pull .env.local` para trazê-las para cá.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
