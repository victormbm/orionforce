# ===== Orion Force — variáveis de ambiente =====
# Copie este arquivo para ".env.local" e preencha.

# Backend de dados:
#   local -> salva no navegador (localStorage)
#   api   -> usa as rotas /api/* + banco Neon (Postgres)
NEXT_PUBLIC_DATA_BACKEND=local

# ===== Banco Neon (Postgres) =====
# No painel do Neon: Project > Connection Details > copie a "Connection string"
# (use a opção "Pooled connection"). Cole aqui:
# DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=
